{
  "name": "moonbase-core",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "main": "./nuxt.config.ts",
  "files": [
    "nuxt.config.ts",
    "public",
    "tailwind.config.ts",
    "tailwind/plugins",
    "app"
  ],
  "scripts": {
    "build:sandbox": "nuxt build sandbox",
    "dev:sandbox": "nuxt dev --port 9000 sandbox",
    "dev:sandbox:network": "nuxt dev --port 9000 --host 0.0.0.0 --qr sandbox",
    "generate:sandbox": "nuxt generate sandbox",
    "preview:sandbox": "nuxt preview sandbox",
    "prepare:sandbox": "nuxt prepare sandbox",
    "prepare:nuxt": "nuxt prepare",
    "postinstall": "nuxt prepare",
    "preinstall": "npx only-allow pnpm",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "start": "node .output/server/index.mjs sandbox",
    "lint:eslint": "eslint --ext .js,.ts,.vue .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:stylelint": "stylelint '**/*.{vue,css}'",
    "lint:stylelint:fix": "pnpm lint:stylelint --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:stylelint:fix && pnpm lint:prettier:fix"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.13.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxtjs/fontaine": "0.5.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "nuxt": "^4.3.1",
    "reka-ui": "^2.8.2",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "vue": "^3.5.28",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/eslint-config": "^1.15.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier-plugin-sort-json": "4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "ts-toolbelt": "^9.6.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4"
  }
}
